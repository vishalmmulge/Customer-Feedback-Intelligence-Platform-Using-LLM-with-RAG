# Customer Feedback Intelligence - environment configuration
# Copy this file to `.env` and adjust values. Never commit `.env` to git.

# Application
LOG_LEVEL=INFO

# Paths
DATABASE_PATH=data/feedback.db
EVALUATION_DATASET_PATH=data/evaluation_dataset.jsonl
UPLOAD_DIRECTORY=data/uploads

# Ollama (used for both embeddings and the RAG LLM)
# Start Ollama locally, then pull the models:
#   ollama pull nomic-embed-text
#   ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2:3b

# RAG
RAG_TOP_K=5
RAG_TEMPERATURE=0.2